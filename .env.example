# ============================================================
#  CAOP — variables de entorno
#  PUBLIC_HOST = host donde corre la infra y por el que la
#  alcanzan navegador y servicios. Producción: 192.168.0.7
#  Si cambias de host, reemplaza 192.168.0.7 en TODO este archivo
#  y en keycloak/realm-caop.json (redirectUris / webOrigins).
# ============================================================
COMPOSE_PROJECT_NAME=caop
ENVIRONMENT=production
TZ=America/Guayaquil
PUBLIC_HOST=192.168.0.7

# ---------- PostgreSQL (aplicación) ----------
POSTGRES_USER=caop
POSTGRES_PASSWORD=caop_dev_password
POSTGRES_DB=caop
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Backend ----------
# Conexiones internas usan nombres de servicio de la red compose (postgres/redis).
DATABASE_URL=postgresql+asyncpg://caop:caop_dev_password@postgres:5432/caop
DATABASE_URL_SYNC=postgresql+psycopg://caop:caop_dev_password@postgres:5432/caop
# CORS: el frontend se sirve por el host público.
BACKEND_CORS_ORIGINS=http://192.168.0.7:3000
LOG_LEVEL=INFO
# Scheduler interno de evaluación de SLA (minutos; 0 = desactivado)
SLA_EVALUATE_INTERVAL_MINUTES=10

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- MinIO ----------
MINIO_ROOT_USER=caop_minio
MINIO_ROOT_PASSWORD=caop_minio_dev_password
# Endpoint INTERNO para operaciones put/get (contenedor -> contenedor). Rápido y fiable.
MINIO_ENDPOINT=http://minio:9000
# Endpoint PÚBLICO usado SOLO para firmar URLs (debe ser alcanzable por el navegador).
# Firmar es local (no hace red), así que el backend no necesita alcanzar este host.
MINIO_PUBLIC_ENDPOINT=http://192.168.0.7:9000
MINIO_BUCKET=caop-documents
MINIO_ACCESS_KEY=caop_minio
MINIO_SECRET_KEY=caop_minio_dev_password
MINIO_SECURE=false

# ---------- Keycloak ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_REALM=caop
# El issuer DEBE ser idéntico para navegador y backend, o la validación del token falla.
KEYCLOAK_URL=http://192.168.0.7:8080
KEYCLOAK_ISSUER=http://192.168.0.7:8080/realms/caop
KEYCLOAK_AUDIENCE=caop-backend

# ---------- Temporal ----------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# ---------- Email (Mailpit en dev, mailcow en prod) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@caop.local
SMTP_USE_TLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ---------- WhatsApp Business Platform (oficial) ----------
# Sin token -> el conector opera en modo SIMULADO (registra pero no envía).
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# WHATSAPP_PHONE_ID=
# WHATSAPP_TOKEN=

# ---------- Frontend ----------
# URL pública (navegador):
NEXT_PUBLIC_API_URL=http://192.168.0.7:8000
# URL interna para SSR (server-side, dentro del contenedor): nombre de servicio compose
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://192.168.0.7:8080
NEXT_PUBLIC_KEYCLOAK_REALM=caop
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=caop-frontend
