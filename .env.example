# ---------- General ----------
COMPOSE_PROJECT_NAME=caop
ENVIRONMENT=development
TZ=America/Guayaquil

# ---------- PostgreSQL (aplicación) ----------
POSTGRES_USER=caop
POSTGRES_PASSWORD=caop_dev_password
POSTGRES_DB=caop
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Backend ----------
# URL async para SQLAlchemy/asyncpg
DATABASE_URL=postgresql+asyncpg://caop:caop_dev_password@postgres:5432/caop
# URL sync para Alembic
DATABASE_URL_SYNC=postgresql+psycopg://caop:caop_dev_password@postgres:5432/caop
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- MinIO ----------
MINIO_ROOT_USER=caop_minio
MINIO_ROOT_PASSWORD=caop_minio_dev_password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=caop-documents

# ---------- Keycloak ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_REALM=caop
KEYCLOAK_URL=http://keycloak:8080
# Issuer visto por el backend para validar tokens
KEYCLOAK_ISSUER=http://localhost:8080/realms/caop
KEYCLOAK_AUDIENCE=caop-backend

# ---------- Temporal ----------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# ---------- Mailpit (correo de desarrollo) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=caop
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=caop-frontend
